{
  "name": "smart-recipe-pantry-planner",
  "version": "1.0.0-dev",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.js",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "demo": "node examples/shortages-demo.js",
    "test": "node --test tests/*.test.js",
    "test:final": "node scripts/check-complete.js && npm test",
    "dev:web": "vite --host 127.0.0.1",
    "start": "node --env-file-if-exists=.env server/index.js",
    "db:init": "node --env-file-if-exists=.env scripts/db.js init",
    "db:migrate": "node --env-file-if-exists=.env scripts/db.js migrate",
    "db:seed": "node --env-file-if-exists=.env scripts/db.js seed",
    "db:repair": "node --env-file-if-exists=.env scripts/db.js repair",
    "db:backup": "node --env-file-if-exists=.env scripts/db.js backup",
    "db:restore": "node --env-file-if-exists=.env scripts/db.js restore",
    "test:api": "node --test tests/api/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "test:e2e": "playwright test",
    "check:v1": "npm run test:final && npm run demo && npm run test:api && npm run test:integration && npm run build && npm run test:e2e"
  },
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@vitejs/plugin-react": "^6.2.1",
    "vite": "^8.3.6"
  }
}
